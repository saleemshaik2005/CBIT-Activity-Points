# ==========================================
# CBIT Activity Points (MAR) Environment Config
# 100% Free Stack Configuration
# ==========================================

# 1. Supabase (Free Tier: Database, Auth, Storage)
# Get these from: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Google Gemini AI (Free Tier: 15 req/min multimodal document OCR & intelligence)
# Get a free key instantly from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# 3. Application URL (For Google OAuth Callback)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Optional Team Sandbox Authentication Gateway
# Generate strong hash: echo -n "your-passcode" | shasum -a 256
SPMS_TEAM_PASS_HASH=your_sha256_passcode_hash_here
# Generate 32+ char secret: openssl rand -hex 32
SPMS_SECRET=your_cryptographically_secure_random_salt_here
