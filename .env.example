# ==============================================================================
# CBIT SPMS (Student Points Management System) - Environment Configuration
# ==============================================================================
# Use separate values for Staging and Production. Never mix production keys into staging!

# 1. Environment Identifier
# Values: 'staging' | 'production' | 'development'
# Controls the STAGING banner indicator and safety assertions.
NEXT_PUBLIC_ENVIRONMENT=staging

# 2. Application Base URL
# Local: http://localhost:3000
# Staging Preview: https://<your-staging-vercel-preview>.vercel.app
# Production: https://cbitspms.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Supabase Configuration (Database, Auth, Storage)
# Obtain from: Supabase Dashboard -> Project Settings -> API
# IMPORTANT: Staging MUST use a dedicated, separate Supabase project!
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 4. Supabase Service Role Key (Server-side ONLY - NEVER expose to client)
# Used for server-side administrative tasks and provisioning scripts
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 5. Google Gemini AI API Key (Multimodal Certificate Analysis)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 6. Web Push (VAPID) Keys (Optional - for browser notifications)
# Generated using web-push CLI (e.g., npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@cbit.ac.in
